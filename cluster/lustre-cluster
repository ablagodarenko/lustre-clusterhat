#!/bin/bash
#
# lustre-cluster - run a Lustre file system on a ClusterHAT
#
#   lustre-cluster init                      one-time setup (done on first boot)
#   lustre-cluster nodes deploy|on|off|status
#   lustre-cluster servers format|start|stop|status
#   lustre-cluster servers failover N [hard] move node N's targets to its partner
#   lustre-cluster servers failback          every target back on its home node
#   lustre-cluster throttle on [MB/s]|off|status
#                                            share a disk I/O band between the OSTs
#   lustre-cluster clients start|mount|umount|stop|status
#   lustre-cluster benchmark disk|net|io|all
#   lustre-cluster up                        nodes on, servers start, clients start + mount
#   lustre-cluster down                      clients stop, servers stop, nodes off
#
# First use after flashing:  nodes deploy, servers format, up

D=$(dirname "$(readlink -f "$0")")

[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

cmd=$1; shift || true
case "$cmd" in
init)       exec "$D/init.sh" "$@" ;;
nodes|servers|clients|benchmark|throttle)
            exec "$D/$cmd.sh" "$@" ;;
up)         "$D/nodes.sh" on && "$D/servers.sh" start &&
            "$D/clients.sh" start && "$D/clients.sh" mount ;;
down)       "$D/clients.sh" stop
            "$D/servers.sh" stop poweroff
            "$D/nodes.sh" off ;;
*)          sed -n '3,18p' "$0"; exit 1 ;;
esac
